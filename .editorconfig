# Pocket Casino
# Tout le depot est en UTF-8 sans BOM, avec des fins de ligne LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{png,woff2,ico}]
charset = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
